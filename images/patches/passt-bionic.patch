diff --git a/ip.h b/ip.h
index aab9b86..a7f5152 100644
--- a/ip.h
+++ b/ip.h
@@ -64,6 +64,14 @@
 		.daddr		= IN6ADDR_ANY_INIT,			\
 	}
 
+/*
+ * bionic's <netinet/ip.h> chain reaches <linux/ipv6.h>, which defines both of
+ * the structures below; glibc's headers leave them to the program. The port
+ * builds against the NDK, where the two definitions collide. _UAPI_IPV6_H is
+ * the guard of that header (bionic keeps the kernel's), so passt's copies are
+ * only used where nothing else has defined them.
+ */
+#ifndef _UAPI_IPV6_H
 struct ipv6hdr {
 #pragma GCC diagnostic push
 #pragma GCC diagnostic ignored "-Wpedantic"
@@ -92,6 +100,7 @@ struct ipv6_opt_hdr {
 	 * TLV encoded option data follows.
 	 */
 } __attribute__((packed));	/* required for some archs */
+#endif /* !_UAPI_IPV6_H */
 
