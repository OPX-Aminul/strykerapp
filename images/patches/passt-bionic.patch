 	for (i = 0; i < LOW_RTT_TABLE_SIZE; i++) {
 		if (inany_equals(&tapside->oaddr, low_rtt_dst + i))
 			return;
-		if (hole == -1 && IN6_IS_ADDR_UNSPECIFIED(low_rtt_dst + i))
