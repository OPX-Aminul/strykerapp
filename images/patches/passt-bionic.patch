+++ b/tcp.c
@@ -327,7 +327,13 @@
  */
 #define OPTLEN_MAX (((1UL << 4) - 1 - 5) * 4UL)
 
-#ifndef __USE_MISC
+/*
+ * __USE_MISC is glibc's: with it <netinet/tcp.h> already carries these. bionic
+ * has no <features.h>, but its <netinet/tcp.h> reaches <linux/tcp.h>, which
+ * defines the same enum and structure -- so only add them when neither of the
+ * two has. (_UAPI_LINUX_TCP_H is that header's guard.)
+ */
+#if !defined(__USE_MISC) && !defined(_UAPI_LINUX_TCP_H)
 /* From Linux UAPI, missing in netinet/tcp.h provided by musl */
 struct tcp_repair_opt {
 	__u32	opt_code;
